{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/prod-log-.json",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 20971520,
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [
      "https://your-domain.com",
      "https://admin.your-domain.com"
    ]
  },

  "SeedData": {
    "AdminEmail": "admin@gmail.com",
    "AdminPassword": ".env"
  },

  "ConnectionStrings": {
    "sqlServerCs": "Server=YOUR_PROD_DB_HOST;Database=VendorHubProdDb;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=False;Encrypt=True;",
    "RedisConnection": "YOUR_REDIS_HOST:6379,password=YOUR_REDIS_PASSWORD,ssl=True,abortConnect=False"
  },

  "JWT": {
    "SecritKey": "UwNz9sD3jNimyIzt5OxruN9dmW1gUnLw0do4e9IxvWCPTKx7Sl3Qa57VIKmZODAX",
    "AudienceIP": "https://your-domain.com",
    "IssuerIP": "https://api.your-domain.com"
  }
}
