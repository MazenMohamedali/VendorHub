# .gitignore for VendorHub (.NET Core + React/Vite + Node)

# Build & Output Directories (.NET)
**/bin/
**/obj/
**/out/
**/logs/
**/*.log

# IDE & Tooling Files
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Frontend Node Modules & Build Outputs
**/node_modules/
**/dist/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.production.local

# OS Generated Files
.DS_Store
Thumbs.db
